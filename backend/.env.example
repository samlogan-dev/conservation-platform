# Server
PORT=8000

# Supabase
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# URL - development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# URL - production
# FRONTEND_URL=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Database — optional; the defaults match docker-compose.yml (Postgres + PostGIS on 54329).
# DATABASE_URL=postgres://platform:platform@localhost:54329/platform
# Password for the AI arm's read-only role, set by `npm run db:migrate`. Change it anywhere
# that is not your own machine.
# AI_READER_PASSWORD=ai_reader_local

# Ingestion — all optional; the defaults are what a local run uses.
# Identifies the harvester to the sources (ethics pillar 1). Put a real contact in it.
# INGESTION_USER_AGENT=UTS-Honours-ConservationPlatform/0.1 (contact: you@example.com)
# Where frozen snapshots and canonical records are written, relative to backend/.
# INGESTION_DATA_DIR=data
# Email of a registered ALA account. Required for ALA offline (bulk) downloads; the API's
# ordinary search needs no account.
# ALA_DOWNLOAD_EMAIL=you@example.com
# Salt for the irreversible observer pseudonyms (ethics pillar 2). Has a committed default
# so the dev loop works without setup; set it for a deployment that matters.
# CONTRIBUTOR_PSEUDONYM_SALT=change-me

# Anthropic key, for the AI analysis arm. Either name is read. Never commit it.
# CLAUDE_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=sk-ant-...
