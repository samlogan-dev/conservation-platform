# Server
PORT=8000

# Supabase
SUPABASE_URL=https://your-supabase-url.supabase.co
SUPABASE_SECRET_KEY=your-secret-key

# URL - development
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# URL - production
# FRONTEND_URL=https://yourdomain.com
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Ingestion — all optional; the defaults are what a local run uses.
# Identifies the harvester to the sources (ethics pillar 1). Put a real contact in it.
# INGESTION_USER_AGENT=UTS-Honours-ConservationPlatform/0.1 (contact: you@example.com)
# Where frozen snapshots and canonical records are written, relative to backend/.
# INGESTION_DATA_DIR=data
# Page 1 serves frozen responses verbatim, precise coordinates included. Set false for any
# deployment that is not local.
# INGESTION_SERVE_RAW=true
# Salt for the irreversible observer pseudonyms (ethics pillar 2). Has a committed default
# so the dev loop works without setup; set it for a deployment that matters.
# CONTRIBUTOR_PSEUDONYM_SALT=change-me

# Text classification (threat and condition extraction). The keyword baseline needs nothing.
# The model classifier needs an Anthropic key; the model id is logged with every run and
# defaults to the cheap tier. Never commit the key.
# ANTHROPIC_API_KEY=sk-ant-...
# TEXT_MODEL=claude-haiku-4-5
